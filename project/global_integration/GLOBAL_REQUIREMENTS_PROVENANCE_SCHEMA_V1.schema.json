{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dossiya-SE/MSE-thesis/project/global_integration/GLOBAL_REQUIREMENTS_PROVENANCE_SCHEMA_V1.schema.json",
  "title": "Global Requirements and Provenance Schema V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "requirements",
    "changes",
    "conflicts",
    "compliance_results"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/change"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conflict"
      }
    },
    "compliance_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/compliance"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "gateStatus": {
      "enum": [
        "PASS",
        "BLOCKED",
        "FAIL",
        "DEFERRED",
        "N/A"
      ]
    },
    "maturity": {
      "enum": [
        "DRAFT",
        "SOURCE_IDENTIFIED",
        "QUALIFIED",
        "BASELINED",
        "SUPERSEDED",
        "RETIRED",
        "REJECTED"
      ]
    },
    "effectivity": {
      "enum": [
        "ACTIVE",
        "FUTURE",
        "EXPIRED",
        "INACTIVE",
        "UNKNOWN"
      ]
    },
    "stage": {
      "enum": [
        "GLOBAL",
        "S1",
        "S2",
        "S3",
        "S4",
        "S5",
        "S6",
        "S7",
        "INSTITUTIONAL"
      ]
    },
    "domain": {
      "enum": [
        "PHYSICAL",
        "SAFETY",
        "SERVICE",
        "RECOVERY",
        "OPERATIONAL_CONTROL",
        "INFORMATION",
        "ORGANIZATION",
        "EFFECTIVENESS",
        "RESOURCE_EFFICIENCY",
        "SUSTAINABILITY",
        "FEASIBILITY",
        "DECISION",
        "EXPERIMENTAL_METHOD",
        "THESIS_INSTITUTIONAL",
        "OTHER"
      ]
    },
    "kind": {
      "enum": [
        "EXTERNALLY_IMPOSED_REQUIREMENT",
        "OPERATOR_REQUIREMENT",
        "STAKEHOLDER_REQUIREMENT",
        "ENGINEERING_DERIVED_REQUIREMENT",
        "SAFETY_CRITERION",
        "SERVICE_CRITERION",
        "RECOVERY_CRITERION",
        "CONTROL_FEASIBILITY_CONSTRAINT",
        "EFFECTIVENESS_TARGET",
        "RESOURCE_CONSTRAINT",
        "SUSTAINABILITY_REQUIREMENT",
        "DECISION_FEASIBILITY_CONSTRAINT",
        "EXPERIMENTAL_PREREGISTRATION_CRITERION",
        "RESEARCH_ASSUMPTION",
        "VALUE_PREFERENCE",
        "INSTITUTIONAL_REQUIREMENT",
        "OTHER"
      ]
    },
    "hardness": {
      "enum": [
        "HARD_ADMISSIBILITY",
        "HARD_SAFETY",
        "HARD_FEASIBILITY",
        "SOFT_TARGET",
        "OBJECTIVE",
        "REPORT_ONLY",
        "ASSUMPTION",
        "PREFERENCE",
        "EXPERIMENTAL_GATE"
      ]
    },
    "authority": {
      "enum": [
        "LAW_REGULATION",
        "MANDATED_STANDARD",
        "VOLUNTARY_STANDARD",
        "CONTRACTUAL",
        "OPERATOR_POLICY",
        "OPERATOR_ENGINEERING",
        "STAKEHOLDER_ELICITED",
        "SAFETY_ENGINEERING",
        "CASE_ENGINEERING_DERIVED",
        "PEER_REVIEWED_EVIDENCE",
        "MANUFACTURER_SPECIFICATION",
        "EXPERIMENTAL_PREREGISTRATION",
        "RESEARCH_ASSUMPTION",
        "VALUE_MODEL",
        "INSTITUTIONAL_POLICY",
        "OTHER"
      ]
    },
    "referenceClass": {
      "enum": [
        "VALIDATION_EVIDENCE",
        "VALIDATION_REFERENCE",
        "REFERENCE_SOLUTION",
        "REFERENCE_CALCULATION",
        "EVIDENCE_SOURCE_REFERENCE",
        "EXTERNAL_PRACTICE_FACTOR_REFERENCE",
        "SYNTHETIC_TRUTH",
        "GROUND_TRUTH",
        "QUALIFIED_CASE",
        "AUXILIARY_COUNTERFACTUAL_MODEL",
        "BENCHMARK_PROBLEM",
        "VERIFICATION_FIXTURE",
        "REQUIREMENT_THRESHOLD",
        "NONE"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_ids",
        "activity_ids",
        "agent_ids",
        "version",
        "hash",
        "status"
      ],
      "properties": {
        "entity_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "activity_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "agent_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/gateStatus"
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "version",
        "title",
        "normalized_statement",
        "domain",
        "kind",
        "hardness",
        "authority_class",
        "authority_entity",
        "source_id",
        "source_locator",
        "jurisdiction_or_scope",
        "applicability_conditions",
        "owning_stage",
        "consumer_stages",
        "object_or_qoi",
        "mathematical_expression",
        "quantity",
        "source_unit",
        "canonical_unit",
        "temporal_aggregation",
        "spatial_aggregation",
        "uncertainty_id",
        "reference_class",
        "verification_method",
        "validation_or_need_confirmation",
        "compliance_evaluation_method",
        "gate_status",
        "maturity_status",
        "effectivity_status",
        "claim_ceiling",
        "provenance"
      ],
      "properties": {
        "requirement_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "normalized_statement": {
          "type": "string",
          "minLength": 1
        },
        "original_source_summary": {
          "type": "string"
        },
        "domain": {
          "$ref": "#/$defs/domain"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "hardness": {
          "$ref": "#/$defs/hardness"
        },
        "authority_class": {
          "$ref": "#/$defs/authority"
        },
        "authority_entity": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_uri_or_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_locator": {
          "type": "string",
          "minLength": 1
        },
        "publication_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "effective_start": {
          "type": [
            "string",
            "null"
          ]
        },
        "effective_end": {
          "type": [
            "string",
            "null"
          ]
        },
        "jurisdiction_or_scope": {
          "type": "string",
          "minLength": 1
        },
        "applicability_conditions": {
          "type": "string",
          "minLength": 1
        },
        "parent_requirement_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "derived_from_requirement_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "derivation_rationale": {
          "type": "string"
        },
        "owning_stage": {
          "$ref": "#/$defs/stage"
        },
        "consumer_stages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stage"
          }
        },
        "object_or_qoi": {
          "type": "string",
          "minLength": 1
        },
        "mathematical_expression": {
          "type": "string",
          "minLength": 1
        },
        "comparison_operator": {
          "type": [
            "string",
            "null"
          ]
        },
        "threshold_or_target": {},
        "quantity": {
          "type": "string",
          "minLength": 1
        },
        "source_unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "canonical_unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "conversion_rule": {
          "type": [
            "string",
            "null"
          ]
        },
        "temporal_aggregation": {
          "type": "string",
          "minLength": 1
        },
        "spatial_aggregation": {
          "type": "string",
          "minLength": 1
        },
        "population_or_group_scope": {
          "type": "string"
        },
        "scenario_hazard_scope": {
          "type": "string"
        },
        "uncertainty_id": {
          "type": "string",
          "minLength": 1
        },
        "reference_class": {
          "$ref": "#/$defs/referenceClass"
        },
        "verification_method": {
          "type": "string",
          "minLength": 1
        },
        "validation_or_need_confirmation": {
          "type": "string",
          "minLength": 1
        },
        "compliance_evaluation_method": {
          "type": "string",
          "minLength": 1
        },
        "gate_status": {
          "$ref": "#/$defs/gateStatus"
        },
        "maturity_status": {
          "$ref": "#/$defs/maturity"
        },
        "effectivity_status": {
          "$ref": "#/$defs/effectivity"
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_id",
        "requirement_id",
        "old_version",
        "new_version",
        "reason",
        "initiator",
        "change_class",
        "approval_or_authority",
        "effective_date",
        "affected_models",
        "affected_scenarios",
        "affected_hypotheses",
        "affected_results",
        "reexecution_required",
        "target_results_seen_before_change",
        "status",
        "provenance"
      ],
      "properties": {
        "change_id": {
          "type": "string",
          "minLength": 1
        },
        "requirement_id": {
          "type": "string",
          "minLength": 1
        },
        "old_version": {
          "type": "string",
          "minLength": 1
        },
        "new_version": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "initiator": {
          "type": "string",
          "minLength": 1
        },
        "change_class": {
          "enum": [
            "SOURCE_CHANGE",
            "INTERPRETATION_CHANGE",
            "FORMALIZATION_CHANGE",
            "SCOPE_CHANGE",
            "THRESHOLD_CHANGE",
            "TYPO_METADATA_ONLY",
            "OTHER"
          ]
        },
        "approval_or_authority": {
          "type": "string",
          "minLength": 1
        },
        "effective_date": {
          "type": "string",
          "minLength": 1
        },
        "affected_models": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "affected_scenarios": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "affected_hypotheses": {
          "type": "array",
          "items": {
            "enum": [
              "H1",
              "H2",
              "H3",
              "H4",
              "H5",
              "NONE"
            ]
          }
        },
        "affected_results": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reexecution_required": {
          "type": "boolean"
        },
        "target_results_seen_before_change": {
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/gateStatus"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conflict_id",
        "requirement_ids",
        "conflict_type",
        "applicability_analysis",
        "resolution_basis",
        "resolution",
        "affected_objects",
        "status",
        "provenance"
      ],
      "properties": {
        "conflict_id": {
          "type": "string",
          "minLength": 1
        },
        "requirement_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "conflict_type": {
          "enum": [
            "NUMERIC",
            "LOGICAL",
            "SCOPE",
            "JURISDICTION",
            "TEMPORAL",
            "AUTHORITY",
            "AGGREGATION",
            "SEMANTIC",
            "OTHER"
          ]
        },
        "applicability_analysis": {
          "type": "string",
          "minLength": 1
        },
        "resolution_basis": {
          "type": "string",
          "minLength": 1
        },
        "resolution": {
          "type": "string",
          "minLength": 1
        },
        "affected_objects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "$ref": "#/$defs/gateStatus"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "compliance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compliance_id",
        "requirement_id",
        "requirement_version",
        "run_or_scenario_id",
        "evaluated_qoi",
        "uncertainty_id",
        "margin",
        "outcome",
        "evaluation_method",
        "provenance"
      ],
      "properties": {
        "compliance_id": {
          "type": "string",
          "minLength": 1
        },
        "requirement_id": {
          "type": "string",
          "minLength": 1
        },
        "requirement_version": {
          "type": "string",
          "minLength": 1
        },
        "run_or_scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "evaluated_qoi": {
          "type": "string",
          "minLength": 1
        },
        "uncertainty_id": {
          "type": "string",
          "minLength": 1
        },
        "margin": {},
        "outcome": {
          "enum": [
            "PASS",
            "FAIL",
            "UNRESOLVED"
          ]
        },
        "evaluation_method": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    }
  }
}
