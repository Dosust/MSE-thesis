{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dossiya-SE/MSE-thesis/schemas/stage1_structure.schema.json",
  "title": "Stage 1 Structural Handoff Contract v2",
  "description": "Machine-readable Stage-1 contract synchronized to the final v2 evidence/ontology register. Stage 1 represents structural possibility only and cannot accept causal dependencies or estimate coupling strength.",
  "type": "object",
  "required": [
    "version",
    "system_boundary",
    "layers",
    "entities",
    "intralayer_edges",
    "candidate_relations",
    "service_traceability",
    "assumptions",
    "provenance",
    "stage1_status",
    "normative_register"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "2.0"
    },
    "system_boundary": {
      "type": "object",
      "required": [
        "geographic_support",
        "temporal_support",
        "infrastructure_scope",
        "service_scope",
        "operating_modes",
        "jurisdiction_context"
      ],
      "properties": {
        "geographic_support": {
          "type": "string",
          "minLength": 1
        },
        "temporal_support": {
          "type": "string",
          "minLength": 1
        },
        "infrastructure_scope": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "service_scope": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "operating_modes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "jurisdiction_context": {
          "type": "object",
          "required": [
            "case_jurisdiction",
            "authority_scope"
          ],
          "properties": {
            "case_jurisdiction": {
              "type": "string",
              "minLength": 1
            },
            "authority_scope": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "layers": {
      "type": "object",
      "required": [
        "physical",
        "supporting"
      ],
      "properties": {
        "physical": {
          "type": "array",
          "const": [
            "power",
            "transportation"
          ]
        },
        "supporting": {
          "type": "array",
          "const": [
            "information",
            "organization"
          ]
        }
      },
      "additionalProperties": false
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "entity_id",
          "entity_type",
          "layer",
          "source_dataset",
          "geometry_ref",
          "state_schema",
          "service_roles",
          "provenance_status",
          "inclusion_rule",
          "engineering_functions",
          "resolution_level",
          "evidence_refs"
        ],
        "properties": {
          "entity_id": {
            "type": "string",
            "minLength": 1
          },
          "entity_type": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "$ref": "#/$defs/layer"
          },
          "source_dataset": {
            "type": "string",
            "minLength": 1
          },
          "geometry_ref": {
            "type": "string",
            "minLength": 1
          },
          "state_schema": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "service_roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "provenance_status": {
            "enum": [
              "PASS",
              "CONDITIONAL",
              "BLOCKED",
              "OPEN"
            ]
          },
          "inclusion_rule": {
            "type": "string",
            "minLength": 1
          },
          "exclusion_rule": {
            "type": [
              "string",
              "null"
            ]
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "operator": {
            "type": [
              "string",
              "null"
            ]
          },
          "regulator": {
            "type": [
              "string",
              "null"
            ]
          },
          "electrical_supplier": {
            "type": [
              "string",
              "null"
            ]
          },
          "transport_authority": {
            "type": [
              "string",
              "null"
            ]
          },
          "jurisdiction": {
            "type": [
              "string",
              "null"
            ]
          },
          "engineering_functions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "resolution_level": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "intralayer_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "edge_id",
          "layer",
          "source_entity",
          "target_entity",
          "edge_semantics",
          "provenance_status"
        ],
        "properties": {
          "edge_id": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "$ref": "#/$defs/layer"
          },
          "source_entity": {
            "type": "string",
            "minLength": 1
          },
          "target_entity": {
            "type": "string",
            "minLength": 1
          },
          "edge_semantics": {
            "type": "string",
            "minLength": 1
          },
          "provenance_status": {
            "enum": [
              "PASS",
              "CONDITIONAL",
              "BLOCKED",
              "OPEN"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "candidate_relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "relation_id",
          "record_level",
          "participants",
          "layer_pair",
          "scope",
          "structural_admissibility",
          "interface_semantics",
          "exchange_semantics",
          "direction",
          "candidate_mechanism",
          "mechanism_status",
          "activation_context",
          "evidence_status",
          "evidence_refs",
          "structural_existence",
          "case_connection_status",
          "strength_status",
          "causal_dependency_accepted",
          "metadata",
          "provenance_status"
        ],
        "properties": {
          "relation_id": {
            "type": "string",
            "minLength": 1
          },
          "record_level": {
            "enum": [
              "MECHANISM_TEMPLATE",
              "CASE_RELATION"
            ]
          },
          "participants": {
            "type": "array",
            "minItems": 2,
            "maxItems": 12,
            "items": {
              "type": "object",
              "required": [
                "entity_id",
                "layer",
                "role"
              ],
              "properties": {
                "entity_id": {
                  "type": "string",
                  "minLength": 1
                },
                "layer": {
                  "enum": [
                    "power",
                    "transportation",
                    "information",
                    "organization",
                    "context"
                  ]
                },
                "role": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "layer_pair": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "enum": [
              "INTRA",
              "INTER",
              "CONTEXT"
            ]
          },
          "structural_admissibility": {
            "type": "object",
            "required": [
              "status",
              "predicate_pass",
              "evidence"
            ],
            "properties": {
              "status": {
                "enum": [
                  "N/A_TEMPLATE",
                  "CANDIDATE",
                  "PASS",
                  "FAIL",
                  "BLOCKED",
                  "UNRESOLVED"
                ]
              },
              "predicate_pass": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "evidence": {
                "type": "object",
                "required": [
                  "asset_crosswalk",
                  "interface_hardware",
                  "spatial_relation",
                  "access_geometry",
                  "geographic_coexposure"
                ],
                "properties": {
                  "asset_crosswalk": {
                    "type": "boolean"
                  },
                  "interface_hardware": {
                    "type": "boolean"
                  },
                  "spatial_relation": {
                    "type": "boolean"
                  },
                  "access_geometry": {
                    "type": "boolean"
                  },
                  "geographic_coexposure": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "interface_semantics": {
            "type": "string",
            "minLength": 1
          },
          "exchange_semantics": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "SOURCE_TO_TARGET",
              "TARGET_TO_SOURCE",
              "BIDIRECTIONAL",
              "UNDIRECTED_SCREENING",
              "CONTEXT_TO_SYSTEM"
            ]
          },
          "candidate_mechanism": {
            "type": [
              "string",
              "null"
            ]
          },
          "mechanism_status": {
            "enum": [
              "PRIOR_DOCUMENTED_FAMILY",
              "CANDIDATE_ONLY",
              "INTRA_STRUCTURAL_SEMANTICS",
              "CONTEXT_ONLY"
            ]
          },
          "activation_context": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "evidence_status": {
            "enum": [
              "K",
              "C_N",
              "C_U",
              "C_L",
              "C_S",
              "C_E",
              "G",
              "U",
              "X"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "structural_existence": {
            "enum": [
              "TEMPLATE_ONLY",
              "CANDIDATE",
              "VERIFIED_STRUCTURAL",
              "UNRESOLVED",
              "EXCLUDED"
            ]
          },
          "case_connection_status": {
            "enum": [
              "NOT_CASE_EVALUATED",
              "CANDIDATE",
              "VERIFIED_STRUCTURAL",
              "UNKNOWN",
              "NOT_APPLICABLE"
            ]
          },
          "strength_status": {
            "const": "NOT_ESTIMATED_STAGE1"
          },
          "causal_dependency_accepted": {
            "const": false
          },
          "metadata": {
            "type": "object",
            "required": [
              "hierarchy_orientation",
              "path",
              "mediator_path",
              "arity",
              "resolution_level",
              "admission_basis",
              "evidence_confidence",
              "normative_admissibility"
            ],
            "properties": {
              "hierarchy_orientation": {
                "enum": [
                  "HORIZONTAL",
                  "CROSS_SCALE",
                  "N/A"
                ]
              },
              "path": {
                "enum": [
                  "DIRECT",
                  "MEDIATED",
                  "N/A"
                ]
              },
              "mediator_path": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "arity": {
                "enum": [
                  "PAIRWISE",
                  "HIGHER_ORDER",
                  "HIGHER_ORDER_POSSIBLE"
                ]
              },
              "resolution_level": {
                "type": "string",
                "minLength": 1
              },
              "admission_basis": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "ASSET_CROSSWALK",
                    "INTERFACE_HARDWARE",
                    "SPATIAL_RELATION",
                    "ACCESS_GEOMETRY",
                    "GEOGRAPHIC_COEXPOSURE",
                    "PRIOR_LITERATURE",
                    "EMPIRICAL_ASSOCIATION",
                    "NORMATIVE_INTERFACE",
                    "OPERATOR_DOCUMENTATION",
                    "OTHER"
                  ]
                }
              },
              "evidence_confidence": {
                "type": "object",
                "required": [
                  "confidence_class",
                  "score",
                  "method"
                ],
                "properties": {
                  "confidence_class": {
                    "enum": [
                      "HIGH",
                      "MEDIUM",
                      "LOW",
                      "UNSCORED"
                    ]
                  },
                  "score": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 1
                  },
                  "method": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "score": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "score"
                      ]
                    },
                    "then": {
                      "properties": {
                        "method": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                ],
                "additionalProperties": false
              },
              "normative_admissibility": {
                "enum": [
                  "PASS",
                  "CONDITIONAL",
                  "BLOCKED",
                  "N/A",
                  "N/A_TEMPLATE"
                ]
              }
            },
            "additionalProperties": false
          },
          "normative_authority_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "provenance_status": {
            "enum": [
              "PASS",
              "CONDITIONAL",
              "BLOCKED",
              "OPEN",
              "EXCLUDED"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "record_level": {
                  "const": "MECHANISM_TEMPLATE"
                }
              },
              "required": [
                "record_level"
              ]
            },
            "then": {
              "properties": {
                "structural_existence": {
                  "const": "TEMPLATE_ONLY"
                },
                "case_connection_status": {
                  "const": "NOT_CASE_EVALUATED"
                },
                "structural_admissibility": {
                  "properties": {
                    "status": {
                      "const": "N/A_TEMPLATE"
                    },
                    "predicate_pass": {
                      "type": "null"
                    }
                  }
                },
                "metadata": {
                  "properties": {
                    "normative_admissibility": {
                      "const": "N/A_TEMPLATE"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "record_level": {
                  "const": "CASE_RELATION"
                }
              },
              "required": [
                "record_level"
              ]
            },
            "then": {
              "not": {
                "properties": {
                  "structural_existence": {
                    "const": "TEMPLATE_ONLY"
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "structural_existence": {
                  "const": "VERIFIED_STRUCTURAL"
                }
              },
              "required": [
                "structural_existence"
              ]
            },
            "then": {
              "properties": {
                "record_level": {
                  "const": "CASE_RELATION"
                },
                "case_connection_status": {
                  "const": "VERIFIED_STRUCTURAL"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "metadata": {
                  "properties": {
                    "path": {
                      "const": "MEDIATED"
                    }
                  },
                  "required": [
                    "path"
                  ]
                }
              },
              "required": [
                "metadata"
              ]
            },
            "then": {
              "properties": {
                "metadata": {
                  "properties": {
                    "mediator_path": {
                      "minItems": 1
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "metadata": {
                  "properties": {
                    "arity": {
                      "const": "PAIRWISE"
                    }
                  },
                  "required": [
                    "arity"
                  ]
                }
              },
              "required": [
                "metadata"
              ]
            },
            "then": {
              "properties": {
                "participants": {
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "scope": {
                  "const": "CONTEXT"
                }
              },
              "required": [
                "scope"
              ]
            },
            "then": {
              "properties": {
                "mechanism_status": {
                  "const": "CONTEXT_ONLY"
                },
                "causal_dependency_accepted": {
                  "const": false
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "service_traceability": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entity_id",
          "service_id",
          "structural_role"
        ],
        "properties": {
          "entity_id": {
            "type": "string",
            "minLength": 1
          },
          "service_id": {
            "type": "string",
            "minLength": 1
          },
          "structural_role": {
            "type": "string",
            "minLength": 1
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assumption_id",
          "statement",
          "reason",
          "consequence",
          "sensitivity_test"
        ],
        "properties": {
          "assumption_id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "consequence": {
            "type": "string",
            "minLength": 1
          },
          "sensitivity_test": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "crs",
        "source_vintage",
        "hashes_complete",
        "topology_qa",
        "spatial_qa"
      ],
      "properties": {
        "crs": {
          "type": "string",
          "minLength": 1
        },
        "source_vintage": {
          "type": "string",
          "minLength": 1
        },
        "hashes_complete": {
          "type": "boolean"
        },
        "topology_qa": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "OPEN"
          ]
        },
        "spatial_qa": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "OPEN"
          ]
        }
      },
      "additionalProperties": false
    },
    "stage1_status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "OPEN"
      ]
    },
    "normative_register": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "authority_id",
          "authority_type",
          "authority_name",
          "jurisdiction",
          "document_id",
          "edition_or_version",
          "status",
          "applicability",
          "verification_status"
        ],
        "properties": {
          "authority_id": {
            "type": "string",
            "minLength": 1
          },
          "authority_type": {
            "enum": [
              "statute",
              "regulation",
              "code",
              "standard",
              "utility_procedure",
              "agency_procedure",
              "guidance",
              "other"
            ]
          },
          "authority_name": {
            "type": "string",
            "minLength": 1
          },
          "jurisdiction": {
            "type": "string",
            "minLength": 1
          },
          "document_id": {
            "type": "string",
            "minLength": 1
          },
          "edition_or_version": {
            "type": "string",
            "minLength": 1
          },
          "effective_from": {
            "type": [
              "string",
              "null"
            ]
          },
          "effective_to": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "current",
              "superseded",
              "draft",
              "historical",
              "unknown"
            ]
          },
          "clause_or_locator": {
            "type": [
              "string",
              "null"
            ]
          },
          "applicability": {
            "enum": [
              "APPLICABLE",
              "CONDITIONAL",
              "NOT_APPLICABLE",
              "UNRESOLVED"
            ]
          },
          "affected_entity_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "affected_interface_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "requirement_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "service_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "requirement_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "measure": {
            "type": [
              "string",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "threshold_or_rule": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "verification_status": {
            "enum": [
              "PASS",
              "CONDITIONAL",
              "BLOCKED",
              "OPEN"
            ]
          },
          "source_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "layer": {
      "type": "string",
      "enum": [
        "power",
        "transportation",
        "information",
        "organization"
      ]
    }
  },
  "additionalProperties": false
}
