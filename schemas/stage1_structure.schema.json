{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dossiya-SE/MSE-thesis/schemas/stage1_structure.schema.json",
  "title": "Stage 1 Structural Handoff Contract",
  "description": "Machine-readable contract for the Stage-1 structural/spatial handoff. This schema does not admit causal dependencies; Stage-2 qualification is separate.",
  "type": "object",
  "required": [
    "version",
    "system_boundary",
    "layers",
    "entities",
    "intralayer_edges",
    "candidate_relations",
    "service_traceability",
    "assumptions",
    "provenance",
    "stage1_status",
    "normative_register"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.2"
    },
    "system_boundary": {
      "type": "object",
      "required": [
        "geographic_support",
        "temporal_support",
        "infrastructure_scope",
        "service_scope",
        "operating_modes",
        "jurisdiction_context"
      ],
      "properties": {
        "geographic_support": {
          "type": "string",
          "minLength": 1
        },
        "temporal_support": {
          "type": "string",
          "minLength": 1
        },
        "infrastructure_scope": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "service_scope": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "operating_modes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "jurisdiction_context": {
          "type": "object",
          "required": [
            "case_jurisdiction",
            "authority_scope"
          ],
          "properties": {
            "case_jurisdiction": {
              "type": "string",
              "minLength": 1
            },
            "authority_scope": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "layers": {
      "type": "object",
      "required": [
        "physical",
        "supporting"
      ],
      "properties": {
        "physical": {
          "type": "array",
          "const": [
            "power",
            "transportation"
          ]
        },
        "supporting": {
          "type": "array",
          "const": [
            "information",
            "organization"
          ]
        }
      },
      "additionalProperties": false
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "entity_id",
          "entity_type",
          "layer",
          "source_dataset",
          "geometry_ref",
          "state_schema",
          "service_roles",
          "provenance_status",
          "inclusion_rule",
          "engineering_functions",
          "resolution_level",
          "evidence_refs"
        ],
        "properties": {
          "entity_id": {
            "type": "string",
            "minLength": 1
          },
          "entity_type": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "$ref": "#/$defs/layer"
          },
          "source_dataset": {
            "type": "string",
            "minLength": 1
          },
          "geometry_ref": {
            "type": "string",
            "minLength": 1
          },
          "state_schema": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "service_roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "provenance_status": {
            "enum": [
              "PASS",
              "CONDITIONAL",
              "BLOCKED",
              "OPEN"
            ]
          },
          "inclusion_rule": {
            "type": "string",
            "minLength": 1
          },
          "exclusion_rule": {
            "type": [
              "string",
              "null"
            ]
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "operator": {
            "type": [
              "string",
              "null"
            ]
          },
          "regulator": {
            "type": [
              "string",
              "null"
            ]
          },
          "electrical_supplier": {
            "type": [
              "string",
              "null"
            ]
          },
          "transport_authority": {
            "type": [
              "string",
              "null"
            ]
          },
          "jurisdiction": {
            "type": [
              "string",
              "null"
            ]
          },
          "engineering_functions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "resolution_level": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "intralayer_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "edge_id",
          "layer",
          "source_entity",
          "target_entity",
          "edge_semantics",
          "provenance_status"
        ],
        "properties": {
          "edge_id": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "$ref": "#/$defs/layer"
          },
          "source_entity": {
            "type": "string",
            "minLength": 1
          },
          "target_entity": {
            "type": "string",
            "minLength": 1
          },
          "edge_semantics": {
            "type": "string",
            "minLength": 1
          },
          "provenance_status": {
            "enum": [
              "PASS",
              "CONDITIONAL",
              "BLOCKED",
              "OPEN"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "candidate_relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "relation_id",
          "source_layer",
          "target_layer",
          "source_entity",
          "target_entity",
          "status_class",
          "structural_predicate_pass",
          "structural_evidence",
          "provenance_status",
          "normative_admissibility",
          "interface_semantics",
          "exchange_semantics",
          "direction",
          "candidate_mechanism_class",
          "candidate_mechanism_status",
          "candidate_operating_context",
          "admission_basis",
          "case_connection_status",
          "resolution_level",
          "evidence_refs",
          "evidence_confidence",
          "strength_status"
        ],
        "properties": {
          "relation_id": {
            "type": "string",
            "minLength": 1
          },
          "source_layer": {
            "$ref": "#/$defs/layer"
          },
          "target_layer": {
            "$ref": "#/$defs/layer"
          },
          "source_entity": {
            "type": "string",
            "minLength": 1
          },
          "target_entity": {
            "type": "string",
            "minLength": 1
          },
          "status_class": {
            "enum": [
              "PRIOR_DOCUMENTED",
              "STRUCTURAL_CANDIDATE",
              "UNRESOLVED",
              "EXCLUDED"
            ]
          },
          "structural_predicate_pass": {
            "type": "boolean"
          },
          "structural_evidence": {
            "type": "object",
            "properties": {
              "asset_crosswalk": {
                "type": "boolean"
              },
              "interface_hardware": {
                "type": "boolean"
              },
              "spatial_relation": {
                "type": "boolean"
              },
              "access_geometry": {
                "type": "boolean"
              },
              "geographic_coexposure": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "provenance_status": {
            "enum": [
              "PASS",
              "CONDITIONAL",
              "BLOCKED",
              "OPEN"
            ]
          },
          "causal_dependency_accepted": {
            "type": "boolean",
            "const": false
          },
          "normative_admissibility": {
            "enum": [
              "PASS",
              "CONDITIONAL",
              "BLOCKED",
              "N/A"
            ]
          },
          "normative_authority_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "interface_semantics": {
            "type": "string",
            "minLength": 1
          },
          "exchange_semantics": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "SOURCE_TO_TARGET",
              "UNDIRECTED_SCREENING"
            ]
          },
          "candidate_mechanism_class": {
            "type": [
              "string",
              "null"
            ]
          },
          "candidate_mechanism_status": {
            "type": "string",
            "const": "CANDIDATE_ONLY"
          },
          "candidate_operating_context": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "admission_basis": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "ASSET_CROSSWALK",
                "INTERFACE_HARDWARE",
                "SPATIAL_RELATION",
                "ACCESS_GEOMETRY",
                "GEOGRAPHIC_COEXPOSURE",
                "PRIOR_LITERATURE",
                "EMPIRICAL_ASSOCIATION",
                "NORMATIVE_INTERFACE",
                "OPERATOR_DOCUMENTATION",
                "OTHER"
              ]
            }
          },
          "case_connection_status": {
            "enum": [
              "CANDIDATE",
              "VERIFIED_STRUCTURAL",
              "UNKNOWN",
              "NOT_APPLICABLE"
            ]
          },
          "resolution_level": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "evidence_confidence": {
            "type": "object",
            "required": [
              "confidence_class",
              "score",
              "method"
            ],
            "properties": {
              "confidence_class": {
                "enum": [
                  "HIGH",
                  "MEDIUM",
                  "LOW",
                  "UNSCORED"
                ]
              },
              "score": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "method": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "score": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "score"
                  ]
                },
                "then": {
                  "properties": {
                    "method": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            ],
            "additionalProperties": false
          },
          "strength_status": {
            "type": "string",
            "const": "NOT_ESTIMATED_STAGE1"
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "case_connection_status": {
                  "const": "VERIFIED_STRUCTURAL"
                }
              },
              "required": [
                "case_connection_status"
              ]
            },
            "then": {
              "anyOf": [
                {
                  "properties": {
                    "structural_evidence": {
                      "properties": {
                        "asset_crosswalk": {
                          "const": true
                        }
                      }
                    }
                  }
                },
                {
                  "properties": {
                    "structural_evidence": {
                      "properties": {
                        "spatial_relation": {
                          "const": true
                        }
                      }
                    }
                  }
                },
                {
                  "properties": {
                    "structural_evidence": {
                      "properties": {
                        "access_geometry": {
                          "const": true
                        }
                      }
                    }
                  }
                },
                {
                  "properties": {
                    "structural_evidence": {
                      "properties": {
                        "geographic_coexposure": {
                          "const": true
                        }
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "service_traceability": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entity_id",
          "service_id",
          "structural_role"
        ],
        "properties": {
          "entity_id": {
            "type": "string",
            "minLength": 1
          },
          "service_id": {
            "type": "string",
            "minLength": 1
          },
          "structural_role": {
            "type": "string",
            "minLength": 1
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assumption_id",
          "statement",
          "reason",
          "consequence",
          "sensitivity_test"
        ],
        "properties": {
          "assumption_id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "consequence": {
            "type": "string",
            "minLength": 1
          },
          "sensitivity_test": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "crs",
        "source_vintage",
        "hashes_complete",
        "topology_qa",
        "spatial_qa"
      ],
      "properties": {
        "crs": {
          "type": "string",
          "minLength": 1
        },
        "source_vintage": {
          "type": "string",
          "minLength": 1
        },
        "hashes_complete": {
          "type": "boolean"
        },
        "topology_qa": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "OPEN"
          ]
        },
        "spatial_qa": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "OPEN"
          ]
        }
      },
      "additionalProperties": false
    },
    "stage1_status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "OPEN"
      ]
    },
    "normative_register": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "authority_id",
          "authority_type",
          "authority_name",
          "jurisdiction",
          "document_id",
          "edition_or_version",
          "status",
          "applicability",
          "verification_status"
        ],
        "properties": {
          "authority_id": {
            "type": "string",
            "minLength": 1
          },
          "authority_type": {
            "enum": [
              "statute",
              "regulation",
              "code",
              "standard",
              "utility_procedure",
              "agency_procedure",
              "guidance",
              "other"
            ]
          },
          "authority_name": {
            "type": "string",
            "minLength": 1
          },
          "jurisdiction": {
            "type": "string",
            "minLength": 1
          },
          "document_id": {
            "type": "string",
            "minLength": 1
          },
          "edition_or_version": {
            "type": "string",
            "minLength": 1
          },
          "effective_from": {
            "type": [
              "string",
              "null"
            ]
          },
          "effective_to": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "current",
              "superseded",
              "draft",
              "historical",
              "unknown"
            ]
          },
          "clause_or_locator": {
            "type": [
              "string",
              "null"
            ]
          },
          "applicability": {
            "enum": [
              "APPLICABLE",
              "CONDITIONAL",
              "NOT_APPLICABLE",
              "UNRESOLVED"
            ]
          },
          "affected_entity_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "affected_interface_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "requirement_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "service_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "requirement_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "measure": {
            "type": [
              "string",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "threshold_or_rule": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "verification_status": {
            "enum": [
              "PASS",
              "CONDITIONAL",
              "BLOCKED",
              "OPEN"
            ]
          },
          "source_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "layer": {
      "type": "string",
      "enum": [
        "power",
        "transportation",
        "information",
        "organization"
      ]
    }
  },
  "additionalProperties": false
}
