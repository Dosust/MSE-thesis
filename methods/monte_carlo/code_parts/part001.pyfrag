def read_csv_records(path: Path) -> Tuple[List[Dict[str, str]], List[str]]:
    with path.open("r", encoding="utf-8-sig", newline="") as f:
        reader = csv.DictReader(f)
        records = [dict(r) for r in reader]
        return records, list(reader.fieldnames or [])


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for block in iter(lambda: f.read(1024 * 1024), b""):
            h.update(block)
    return h.hexdigest()


def txt(v: Any) -> str:
    if v is None:
        return ""
    return str(v).strip()


def low(v: Any) -> str:
    return txt(v).lower()


def norm_title(v: Any) -> str:
    s = low(v)
    s = re.sub(r"https?://\S+", " ", s)
    s = re.sub(r"[^a-z0-9]+", " ", s)
    return re.sub(r"\s+", " ", s).strip()


def split_labels(v: Any) -> List[str]:
    return [x.strip() for x in re.split(r"[;,|]+", txt(v)) if x.strip()]


def safe_float(v: Any) -> float:
    try:
        s = txt(v)
        return float(s) if s else math.nan
    except Exception:
        return math.nan


def contains_any(text: str, patterns: List[str]) -> bool:
    return any(re.search(p, text, flags=re.I) for p in patterns)


def matched_fraction(text: str, patterns: List[str]) -> float:
    if not patterns:
        return 0.0
    hits = sum(bool(re.search(p, text, flags=re.I)) for p in patterns)
    return min(1.0, hits / max(1.0, min(3.0, len(patterns))))


def validate_frozen_dataset(records: List[Dict[str, str]], headers: List[str]) -> Dict[str, Any]:
    missing_cols = sorted(REQUIRED_COLUMNS.difference(headers))
    if missing_cols:
        raise ValueError(f"Missing required columns: {missing_cols}")
    if len(records) != EXPECTED_N:
        raise ValueError(f"Frozen dataset condition failed: expected {EXPECTED_N} rows, found {len(records)}")

    ids = [txt(r["Canonical_ID"]) for r in records]
    if any(not x for x in ids):
        raise ValueError("Canonical_ID contains missing values")
    dup_ids = [x for x, n in Counter(ids).items() if n > 1]
    if dup_ids:
        raise ValueError(f"Duplicate Canonical_ID values remain: {dup_ids[:10]}")

    # DOI uniqueness among non-empty DOI values.
    dois = [low(r["DOI"]).replace("https://doi.org/", "").strip() for r in records if txt(r["DOI"])]
    dup_dois = [x for x, n in Counter(dois).items() if n > 1]
    if dup_dois:
        raise ValueError(f"Duplicate DOI values remain: {dup_dois[:10]}")

    # Exact normalized title uniqueness.
    nts = [norm_title(r["Canonical_Title"]) for r in records]
    dup_titles = [x for x, n in Counter(nts).items() if x and n > 1]
    if dup_titles:
        raise ValueError(f"Duplicate normalized titles remain: {dup_titles[:10]}")

    return {
        "n_rows": len(records),
        "unique_ids": len(set(ids)),
        "nonempty_dois": len(dois),
        "duplicate_dois": len(dup_dois),
        "duplicate_normalized_titles": len(dup_titles),
    }


def protocol_support(r: Dict[str, str]) -> bool:
    return (
        txt(r.get("Relevance_259")) == "C_PROTOCOL_SUPPORT"
        or "systematic review methodology" in low(r.get("Primary_Discipline"))
    )


def critical_metadata_hold(r: Dict[str, str]) -> bool:
    # A conflicting DOI is identity-critical and cannot be silently resolved from this frozen dataset.
    return "CONFLICTING_DOI" in txt(r.get("Data_Quality_Notes")).upper()


def identity_ok(r: Dict[str, str]) -> bool:
    return all(txt(r.get(c)) for c in ["Canonical_ID", "Canonical_Title", "Journal", "URL"])


