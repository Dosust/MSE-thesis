#!/usr/bin/env python3
"""
PRISMA-compatible Monte Carlo ranking for the frozen 325-paper thesis corpus.

IMPORTANT:
- Uses ONLY the supplied CSV. No internet, API, Crossref, Scopus, Google Scholar,
  citation counts, journal metrics, or outside metadata are used.
- PRISMA is used for transparent eligibility/reporting gates. PRISMA itself is
  not a paper-ranking method. Ranking is performed by a stochastic MCDA/SMAA-like
  Monte Carlo layer after eligibility.
- Prior ranking outputs in the dataset are NEVER used to compute the new score:
  Final_Unique_Rank, Best_Priority_Tier, Max_Importance_Score, Selected_Core_164,
  Rank_76, Rank_141, and Rank_164 are validation-only fields.

Default input is adapted exactly to:
Thesis_Final_Unique_Papers_325_2026-08-20(3).csv
"""

from __future__ import annotations

